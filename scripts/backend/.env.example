# Personal Agent — Ortam Değişkenleri
# Kullanım: cp .env.example .env  →  değerleri doldur  →  ./install.sh

# ── WhatsApp Cloud API ────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN       # Meta Developer → WhatsApp → API Setup → Access Token
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID          # Meta Developer → WhatsApp → API Setup → Phone Number ID
WHATSAPP_APP_SECRET=YOUR_APP_SECRET                    # Meta Developer → Uygulama → App Secret (HMAC doğrulama için)
WHATSAPP_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN        # Webhook doğrulama için kendin belirle (rastgele string)
WHATSAPP_OWNER=+90XXXXXXXXXX                           # Komut gönderecek WhatsApp numarası (+ ile ülke kodu)
# WHATSAPP_API_VERSION=v19.0                           # Meta API sürümü (varsayılan: v19.0)

# ── Güvenlik ─────────────────────────────────────────────────────
API_KEY=YOUR_INTERNAL_API_KEY                          # /agent/* endpoint'leri için X-Api-Key (güçlü rastgele string)
TOTP_SECRET=YOUR_BASE32_TOTP_SECRET                    # python -c "import pyotp; print(pyotp.random_base32())"
TOTP_SECRET_ADMIN=YOUR_BASE32_ADMIN_TOTP_SECRET        # !restart / !shutdown için ayrı TOTP (pyotp.random_base32())

# ── Anthropic / Claude ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY        # claude.ai/settings → API Keys
# DEFAULT_MODEL=claude-sonnet-4-6                      # Varsayılan Claude modeli (varsayılan: claude-sonnet-4-6)
# INTENT_CLASSIFIER_MODEL=claude-haiku-4-5-20251001    # Niyet sınıflandırma modeli — hız/maliyet için küçük model

# ── LLM Adaptör Seçimi ────────────────────────────────────────────
# LLM_BACKEND=anthropic                                # anthropic (varsayılan) | ollama | gemini
# OLLAMA_BASE_URL=http://localhost:11434               # Ollama sunucu adresi
# OLLAMA_MODEL=llama3                                  # Ollama model adı
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY                   # LLM_BACKEND=gemini ise gerekli (aistudio.google.com)
# GEMINI_MODEL=gemini-2.0-flash                        # Gemini model adı (varsayılan: gemini-2.0-flash)

# ── Servis Portları ───────────────────────────────────────────────
# FASTAPI_PORT=8010                                    # FastAPI (Uvicorn) portu (varsayılan: 8010)
# BRIDGE_PORT=8013                                     # Claude Code Bridge (Node.js) portu (varsayılan: 8013)

# ── Claude Code Bridge Ayarları ──────────────────────────────────
CLAUDE_BRIDGE_URL=http://localhost:8013                # Bridge URL (FastAPI → Bridge iletişimi)
# CLAUDE_CODE_PERMISSIONS=bypassPermissions            # CLI izin modu (varsayılan: bypassPermissions; "default" = araç onayı aktif)
# CLAUDE_CODE_MAX_TURNS=1000                           # Maksimum tur sayısı (varsayılan: 1000)
# CLAUDE_CODE_TIMEOUT_MS=1800000                       # İstek zaman aşımı ms (varsayılan: 1800000 = 30 dk; P99=11dk, max=23dk gözlendi)
# CLAUDE_CODE_PROGRESS_INTERVAL_MS=120000              # Uzun sorgularda ara bildirim aralığı ms (varsayılan: 120000 = 2 dk; 0 = kapalı)
# PERMISSION_APPROVAL_TIMEOUT_MS=300000                # Araç onayı bekleme süresi ms (varsayılan: 300000 = 5 dk)
# BRIDGE_CLIENT_TIMEOUT=1800                           # FastAPI→Bridge HTTP istemci zaman aşımı saniye (varsayılan: 1800 = 30 dk)

# ── Yol Ayarları (isteğe bağlı) ──────────────────────────────────
# Varsayılan: repo kökünden otomatik hesaplanır. Değiştirmen gerekmez.
# ROOT_DIR=/absolute/path/to/99-root
# PROJECTS_DIR=/absolute/path/to/99-root/data/projects
# SESSIONS_DIR=/absolute/path/to/99-root/data/claude_sessions
# CONV_HISTORY_DIR=/absolute/path/to/99-root/data/conv_history
# ACTIVE_CONTEXT_PATH=/absolute/path/to/99-root/data/active_context.json

# ── Webhook Proxy ────────────────────────────────────────────────
# WEBHOOK_PROXY=none                                   # ngrok | cloudflared | external | none (varsayılan: none)
# PUBLIC_URL=https://your-domain.com                   # WEBHOOK_PROXY=external ise zorunlu
# NGROK_AUTHTOKEN=YOUR_NGROK_TOKEN                     # WEBHOOK_PROXY=ngrok + ücretsiz hesap için opsiyonel

# ── Messenger Adaptörü ───────────────────────────────────────────
# MESSENGER_TYPE=whatsapp                              # Aktif platform: whatsapp (varsayılan) | telegram

# ── Telegram Bot API (MESSENGER_TYPE=telegram ise zorunlu) ───────
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...                 # BotFather → /newbot → token
# TELEGRAM_CHAT_ID=987654321                           # Owner chat_id (tek kullanıcı)
# TELEGRAM_WEBHOOK_SECRET=gizli_token                  # setWebhook secret_token — production'da zorunlu

# ── Diğer ────────────────────────────────────────────────────────
# SESSION_TTL_HOURS=24                                 # Oturum yaşam süresi (varsayılan: 24 saat)
# LOG_LEVEL=INFO                                       # Uvicorn log seviyesi: DEBUG | INFO | WARNING | ERROR
# DEFAULT_LANGUAGE=tr                                  # Varsayılan arayüz dili: tr | en
# TIMEZONE=Europe/Istanbul                             # APScheduler ve cron ifadeleri için saat dilimi (IANA, varsayılan: Europe/Istanbul)
# ENVIRONMENT=development                              # production | development (varsayılan: development)
# CORS_ORIGINS=http://localhost:5678                   # Virgülle ayrılmış CORS origin listesi

# ── Yetenek Kısıtlamaları (FEAT-3) ──────────────────────────────
# RESTRICT_* : false = aktif (varsayılan), true = kısıtlı
# *_ENABLED  : true = aktif (varsayılan), false = devre dışı  →  bkz. Desktop / Browser bölümleri
# install.sh --reconfigure-capabilities wizard'ı tüm bu flag'leri tek menüde sorar.
# RESTRICT_FS_OUTSIDE_ROOT=false                       # Proje kökü dışı dosya yolu erişimi
# RESTRICT_NETWORK=false                               # Dış ağ / HTTP istekleri
# RESTRICT_SHELL=false                                 # Kabuk komutu çalıştırma
# RESTRICT_SERVICE_MGMT=false                          # Systemd/tmux servis yönetimi
# RESTRICT_MEDIA=false                                 # Medya mesajları (image/video/document/audio)
# RESTRICT_CALENDAR=false                              # Takvim ve zamanlanmış görevler
# RESTRICT_PROJECT_WIZARD=false                        # Proje oluşturma wizard'ı
# RESTRICT_SCREENSHOT=false                            # Headless browser / ekran görüntüsü
# RESTRICT_SCHEDULER=false                             # APScheduler alt sistemi — startup'ta devre dışı bırakır
# RESTRICT_PDF_IMPORT=false                            # PDF içe aktarma ve proje dönüştürme hattı
# RESTRICT_CONV_HISTORY=false                          # Konuşma geçmişi SQLite kaydı (gizlilik)
# RESTRICT_PLANS=false                                 # İş planı oluşturma ve yönetimi (!plan komutları)
# RESTRICT_INTENT_CLASSIFIER=false                     # LLM tabanlı niyet tespiti (mesaj başına API çağrısı)

# ── Desktop Otomasyon (FEAT-12) ──────────────────────────────────
# DESKTOP_ENABLED=true                                 # false → tüm /internal/desktop aksiyonları devre dışı (varsayılan: true)  ← capability wizard kapsamında
# SYSTEM_PSSWRD=your_system_password                   # sudo -S ve loginctl kilit açma için Ubuntu/sistem şifresi (loglara yazılmaz)
# DESKTOP_RECORDING=false                              # true → record_screen aksiyonu etkin (varsayılan: false)
# DESKTOP_RECORDING_MAX_MB=16                          # Ekran kaydı boyut limiti MB; aşılırsa yalnızca dosya yolu döner

# ── Tarayıcı Otomasyonu (FEAT-13/FEAT-15) ───────────────────────
# BROWSER_ENABLED=true                                 # false → tüm /internal/browser aksiyonları devre dışı (varsayılan: true)  ← capability wizard kapsamında
# BROWSER_HEADLESS=true                                # false → Chromium görünür pencerede çalışır (varsayılan: true)
# BROWSER_SESSIONS_DIR=data/browser_sessions           # Disk kalıcı oturum dosyaları dizini

# ── Site-özel credential store (FEAT-16) ─────────────────────────
# Format: CREDENTIAL_<SITE_SLUG>_USER ve CREDENTIAL_<SITE_SLUG>_PASS
# site_slug: site adındaki nokta/tire yerine alt çizgi kullan
# Claude bu değerleri okuyarak otomatik form doldurabilir (hardcode gerekmez)
# Kullanım: {"action": "get_credential", "site_slug": "mercek_itu", "field": "user"}
#           {"action": "list_credentials"}
# Örnekler:
# CREDENTIAL_MERCEK_ITU_USER=emin.yildiz
# CREDENTIAL_MERCEK_ITU_PASS=sifrem123
# CREDENTIAL_GITHUB_USER=emin
# CREDENTIAL_GITHUB_PASS=ghp_xxxxxxxxxx
